# PostgreSQL example
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/bookshelf

# Local quick start fallback (SQLite)
DATABASE_URL=sqlite+pysqlite:///./fastapi_rest.db

JWT_SECRET=replace-with-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
APP_NAME=bookshelf-api
APP_VERSION=1.0.0

